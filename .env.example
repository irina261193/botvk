# Ключ доступа сообщества с правом на сообщения
VK_TOKEN=replace_me

# Числовой ID сообщества без знака минус
VK_GROUP_ID=123456789

# Числовые VK ID администраторов через запятую
ADMIN_IDS=12345678

# Необязательно: версия VK API
VK_API_VERSION=5.199

# Необязательно: готовое вложение вида doc-123_456. Если пусто, PDF загрузится при старте.
# VK_PDF_ATTACHMENT=
